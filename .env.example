# SQLite database location (created by `bunx prisma db push`).
# IMPORTANT: Prisma resolves relative `file:` paths against the SCHEMA directory
# (prisma/schema.prisma) — NOT the project root. `file:../db/custom.db` therefore
# lands in <repo>/db/custom.db, which is exactly what README and .gitignore
# (db/, *.db) document. Keep it schema-relative on every machine.
DATABASE_URL=file:../db/custom.db

# ---------------------------------------------------------------------------
# Claude API (required for every AI feature: swarm, missions, chimeras, audit)
# Create a key at https://platform.claude.com/ — server-side only, never exposed to the browser.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Optional: route through a gateway/proxy. Default: https://api.anthropic.com
# ANTHROPIC_BASE_URL=

# Optional: model per tier (defaults shown). Triage/profiles run on BALANCED, planning,
# execution, chimeras and the adversarial audit run on DEEP, FRONTIER is opt-in per call.
# HUNTER_MODEL_FRONTIER=claude-fable-5-2
# HUNTER_MODEL_DEEP=claude-opus-5-5
# HUNTER_MODEL_BALANCED=claude-sonnet-5-5
# HUNTER_MODEL_FAST=claude-haiku-5-5

# Optional: max parallel Claude requests in this process (1-16, default 4).
# HUNTER_LLM_CONCURRENCY=4

# ---------------------------------------------------------------------------
# GitHub (optional but recommended — or paste a PAT into the token card in the UI)
# ---------------------------------------------------------------------------
# GITHUB_TOKEN=
