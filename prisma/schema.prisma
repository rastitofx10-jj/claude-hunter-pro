generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Repos saved for tracking (Watchlist)
model SavedRepo {
  id          Int      @id @default(autoincrement())
  fullName    String   @unique // owner/name
  owner       String
  name        String
  url         String
  description String?
  stars       Int      @default(0)
  score       Int      @default(0)
  models      String?  // Comma-separated list of detected models
  evidence    String?  // JSON of evidence
  // SPDX license — basis for deciding which intel can be distributed/used commercially
  license     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Search history
model SearchHistory {
  id          Int      @id @default(autoincrement())
  mode        String   // repos | code
  query       String
  filters     String?  // JSON of filters
  resultCount Int      @default(0)
  createdAt   DateTime @default(now())
}

// System settings (key-value) — includes the GitHub token used by the server, among other things
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// DNA artifact — a capability file mined from an elite repo (skill/command/agent/CLAUDE.md)
model DnaArtifact {
  id          Int      @id @default(autoincrement())
  sourceRepo  String   // owner/name
  path        String   // Full path inside the repo
  kind        String   // skill | command | agent | claude-md | agents-md | mcp-config
  name        String   // Capability name
  description String?
  content     String?  // File content (full or excerpt)
  rawUrl      String?
  size        Int      @default(0)
  // SPDX license of the source repo at mining time (MIT/Apache-2.0/GPL-3.0...).
  // "self" = born from our own field reports. null = unknown (backfill pending).
  // Without this field there is no lawful commercial distribution of derivatives.
  license     String?
  createdAt   DateTime @default(now())

  @@unique([sourceRepo, path])
  @@index([sourceRepo])
  @@index([kind])
}

// Chimera — a merged AI creation synthesized from several elite repos + work orders for our product
model Chimera {
  id          Int      @id @default(autoincrement())
  name        String
  // One-sentence summary — previously not stored at all, and the history view faked it from breakthrough
  oneLiner    String?
  sources     String   // Comma-separated list of source repos
  skillMd     String   // Full SKILL.md ready for injection
  principles  String?  // JSON array of principles
  workOrders  String?  // JSON array of work orders
  breakthrough String? // The single breakthrough idea
  createdAt   DateTime @default(now())
}

// Compiled mission — a natural-language goal turned into an executable battle plan
// with automatic selection of relevant DNA + a field-report loop that births new DNA
model Mission {
  id              Int      @id @default(autoincrement())
  goal            String   // The goal in natural language
  context         String?  // Additional context from the user
  status          String   @default("compiled") // compiled | in_progress | partial | done | failed | voided (partial was added in round 6; round 8 documented 'voided' — written by truth-migration as a TERMINAL fiction-purge state, rank 4 in mission-status.ts, 24/30 production rows carry it — the old comment omitted it and contradicted the code)
  missionName     String   // Codename for the mission
  plan            String   // JSON: array of phases with steps
  dnaRefs         String?  // JSON: selected DnaArtifact ids + rationales
  promptSequence  String?  // JSON: ready-to-paste prompt sequence for Claude Code
  skillMd         String?  // Full operational SKILL.md for injection
  risks           String?  // JSON array of risks
  successCriteria String?  // JSON array of success criteria
  report          String?  // JSON: outcome, distilled lessons
  autopilot       String?  // JSON: per-phase autonomous-run outputs
  autopilotAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Deep sweep — a full intelligence operation: query arsenal -> mining -> prompt swarm
// Stored as a complete run so it can be tracked, replayed and compared across rounds.
model SweepRun {
  id        Int       @id @default(autoincrement())
  status    String    @default("running") // running | done | failed
  phase     String    @default("queries") // queries | enrich | mine | swarm | done
  progress  Int       @default(0) // 0-100
  queries   String?   // JSON: every query executed + result count
  stats     String?   // JSON: candidatesFound, reposMined, dnaAdded, llmCalls, elapsedMs...
  findings  String?   // JSON: ranked candidates with verdicts
  briefing  String?   // JSON: prompt-swarm outputs (patterns, attack plan, next queries)
  audit     String?   // JSON: adversarial audit — live evidence verification + anti-slop score
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Status is queried on every start/step/reap — previously a full scan without an index
  @@index([status])
}

// ============================================================
// Live hunt — a fully autonomous kill chain in one click:
// live GitHub discovery -> prompt swarm -> DNA mining -> mission compile
// -> autonomous execution -> field refinement (the library grows) -> campaign verdict.
// One stage per call — state is persisted in the DB, resumable from any point.
// ============================================================
model LiveHunt {
  id        Int       @id @default(autoincrement())
  status    String    @default("running") // running | done | failed
  stageKey  String    @default("hunt") // hunt | swarm | attack | mine | compile | execute | grow | verdict (attack was added to this comment — the old comment omitted it)
  stages    String    @default("[]") // JSON: completed stage records [{key,title,summary,ms,evidence}]
  goal      String    @default("") // Goal auto-derived from the findings (filled in at the compile stage)
  missionId Int? // The mission created at the compile stage
  generation Int      @default(1) // Hunt generation — generation 2+ seeds the evolved queries of the previous hunt
  seededFrom Int? // Id of the hunt from which the evolved queries were seeded (null = generation 1)
  dnaBefore Int       @default(0) // Library size at the start — to prove growth
  dnaAfter  Int       @default(0) // Library size at the end
  llmCalls  Int       @default(0) // Total LLM calls in the chain
  elapsedMs Int       @default(0) // Cumulative stage time
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Status is queried on every start/step/previousKnownRepos — previously a full scan without an index
  @@index([status])
}
